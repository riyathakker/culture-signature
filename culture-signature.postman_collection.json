            "description": "Amount is computed server-side from items+promoCode. Returns razorpay_order_id, amount (paise), currency, key_id.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"id\": \"PRODUCT_ID\",\n      \"quantity\": 1,\n      \"color\": \"\"\n    }\n  ],\n  \"promoCode\": \"\",\n  \"customerName\": \"Jane Doe\",\n  \"customerEmail\": \"customer@example.com\",\n  \"customerPhone\": \"9999999999\"\n}"
