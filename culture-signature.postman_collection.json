                "orders"
              ]
            },
            "description": "Verifies the Razorpay signature + captured amount server-side before creating the PAID order.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"id\": \"PRODUCT_ID\",\n      \"quantity\": 1,\n      \"color\": \"\"\n    }\n  ],\n  \"promoCode\": \"\",\n  \"shippingAddress\": {\n    \"firstName\": \"Jane\",\n    \"lastName\": \"Doe\",\n    \"street\": \"1 MG Road\",\n    \"city\": \"Mumbai\",\n    \"state\": \"MH\",\n    \"zipCode\": \"400001\",\n    \"country\": \"India\",\n    \"phone\": \"9999999999\"\n  },\n  \"razorpay_order_id\": \"order_XXXXXXXX\",\n  \"razorpay_payment_id\": \"pay_XXXXXXXX\",\n  \"razorpay_signature\": \"SIGNATURE\"\n}"
