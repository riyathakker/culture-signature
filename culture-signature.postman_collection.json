{
  "info": {
    "name": "Culture Signature API",
    "_postman_id": "culture-signature-api",
    "description": "Full API for the Culture Signature storefront (Next.js App Router).\n\n## Setup\n1. Set the `base_url` variable (default `http://localhost:3002`).\n2. **Auth:** most user/admin routes require a NextAuth session cookie. Log in through the web app, open DevTools → Application → Cookies, copy the whole `authjs.session-token` (or `next-auth.session-token`) cookie as `name=value`, and paste it into the `session_cookie` collection variable. Admin routes additionally require the logged-in user to have role ADMIN.\n3. `cron_secret` is the Bearer token for the cron endpoint.\n\nBodies shown are examples — replace ids/values as needed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3002"
    },
    {
      "key": "session_cookie",
      "value": "authjs.session-token=PASTE_HERE"
    },
    {
      "key": "cron_secret",
      "value": "PASTE_CRON_SECRET"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup — send OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/otp/send",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "otp",
                "send"
              ]
            },
            "description": "Step 1 of signup. Emails a 6-digit code (valid 10 min). Always returns a generic message.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\"\n}"
            }
          }
        },
        {
          "name": "Signup — create account (with OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/signup",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ]
            },
            "description": "Step 2 of signup. Requires the code emailed by /api/auth/otp/send. Password min 8 chars.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"customer@example.com\",\n  \"password\": \"password123\",\n  \"code\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "Login (NextAuth credentials)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/callback/credentials",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "callback",
                "credentials"
              ]
            },
            "description": "NextAuth credentials sign-in. In practice log in via the web app to obtain the session cookie; this endpoint expects a CSRF token flow. Prefer copying the cookie from the browser.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Session",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/session",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "session"
              ]
            },
            "description": "Returns the current NextAuth session (uses the cookie)."
          }
        },
        {
          "name": "Delete my account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "{{session_cookie}}",
                "description": "Paste your logged-in session cookie (see collection docs)."
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/delete-account",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "delete-account"
              ]
            },
            "description": "Soft-deletes the logged-in user and their data."
          }
        }
      ]
    },
